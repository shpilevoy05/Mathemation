# Пример прод-окружения. Скопировать в .env.production рядом с репозиторием и
# заполнить реальными значениями. Файл с настоящими значениями не коммитится —
# он в .gitignore, и это единственное место, где живут секреты.
#
# Всё, что помечено «обязательно», проверяется на старте: процесс с DEBUG=0 не
# поднимется на дев-ключе, на ALLOWED_HOSTS='*', на SQLite и с боевым
# эквайрингом без секрета подписи.

# --- Django (обязательно) ---
DJANGO_DEBUG=0
# Не менее 50 символов; сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=matemacia.ru,www.matemacia.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://matemacia.ru,https://www.matemacia.ru
# TLS терминируется на nginx: без этого Django считает запрос http.
DJANGO_BEHIND_PROXY=1
DJANGO_LOG_LEVEL=INFO
# Получатели писем о необработанных ошибках django.request.
DJANGO_ADMINS=Администратор <admin@matemacia.ru>

# --- Электронная почта ---
# Backend можно заменить на console только для диагностики. Пароль SMTP — секрет.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Матемация <noreply@matemacia.ru>
SERVER_EMAIL=Ошибки Матемации <errors@matemacia.ru>
# Отключить только после юридической проверки документов.
LEGAL_DOCS_DRAFT=1
# В проде по умолчанию 1; значение 0 допустимо только для осознанной паузы шлюза.
LEGAL_CONSENT_ENFORCED=1

# --- Управляемая база (обязательно) ---
POSTGRES_DB=matemacia
POSTGRES_USER=matemacia
POSTGRES_PASSWORD=
POSTGRES_HOST=rc1a-xxxxxxxx.mdb.yandexcloud.net
POSTGRES_PORT=6432
POSTGRES_CONN_MAX_AGE=60
# Управляемая база живёт в чужой сети: соединение шифруется и сертификат
# проверяется. Корневой сертификат провайдера кладётся в образ или монтируется.
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/app/infra/production/certs/db-root.crt

# --- Управляемый Redis (обязательно) ---
# Общий кеш обязателен: без него лимит частоты считается у каждого воркера
# отдельно и перестаёт быть лимитом. Схема rediss:// — соединение по TLS.
REDIS_URL=rediss://:password@rc1a-xxxxxxxx.mdb.yandexcloud.net:6380/0

# --- Файлы ---
# Каталог с работами учеников. Внутри MEDIA_ROOT его быть не должно.
PRIVATE_MEDIA_ROOT=/app/private-media
# Должно совпадать с internal-локацией в nginx.conf.
PRIVATE_MEDIA_NGINX_LOCATION=/private-media
SOLUTION_UPLOAD_MAX_BYTES=10485760

# --- Доступ к платной части ---
# 0 — продукт открыт всем зарегистрированным; 1 — работает подписка.
BILLING_ENFORCED=0
TRIAL_DAYS=7
FREE_FEATURES=
# Провайдер эквайринга (dotted path) и секрет подписи его колбэков.
# С боевым провайдером без секрета процесс не стартует.
BILLING_PROVIDER=apps.billing.providers.MockPaymentProvider
BILLING_WEBHOOK_SECRET=

# --- Видео ---
VIDEO_ALLOWED_HOSTS=kinescope.io,rutube.ru
VIDEO_LINK_TTL_SECONDS=600
# Без ключа ссылки на видео остаются публичными.
KINESCOPE_SIGNING_KEY=
KINESCOPE_KEY_ID=

# --- ИИ-наставник ---
# Пока ключ пуст, наставник работает на детерминированной заглушке.
AI_MENTOR_PROVIDER=apps.ai_mentor.providers.MockHintProvider
AI_MENTOR_LLM_FORMAT=openai
AI_MENTOR_LLM_BASE_URL=
AI_MENTOR_LLM_API_KEY=
AI_MENTOR_LLM_MODEL=
AI_MENTOR_LLM_FOLDER_ID=
AI_MENTOR_LLM_TIMEOUT_SECONDS=20
AI_MENTOR_LLM_MAX_TOKENS=400
AI_MENTOR_LLM_TEMPERATURE=0.3
AI_MENTOR_DAILY_HINT_LIMIT=20
# Рубли за 1000 входных/выходных токенов; 0 отключает денежную оценку.
AI_MENTOR_COST_PER_1K_INPUT=0
AI_MENTOR_COST_PER_1K_OUTPUT=0
# Отдельный случайный секрет для необратимых псевдонимов внешних LLM-запросов.
# Если пуст, приложение выводит отдельный ключ из DJANGO_SECRET_KEY через HMAC.
AI_PRIVACY_PSEUDONYM_KEY=

# --- Агент социальных сетей ---
SOCIAL_AGENT_ENABLED=0
SOCIAL_AGENT_PUBLISH_ENABLED=0
SOCIAL_AGENT_PROVIDER=apps.social_agent.providers.MockProvider
SOCIAL_AGENT_LLM_FORMAT=openai
SOCIAL_AGENT_LLM_BASE_URL=
SOCIAL_AGENT_LLM_API_KEY=
SOCIAL_AGENT_LLM_MODEL=
SOCIAL_AGENT_LLM_FOLDER_ID=
SOCIAL_AGENT_LLM_TIMEOUT_SECONDS=20
SOCIAL_AGENT_LLM_MAX_TOKENS=800
SOCIAL_AGENT_LLM_TEMPERATURE=0.3
SOCIAL_AGENT_COST_PER_1K_INPUT=0
SOCIAL_AGENT_COST_PER_1K_OUTPUT=0
SOCIAL_AGENT_TELEGRAM_BOT_TOKEN=
SOCIAL_AGENT_REVIEW_CHAT_IDS=
SOCIAL_AGENT_REVIEWER_USER_IDS=
SOCIAL_AGENT_MAX_REWRITES=2

# --- Лимиты частоты ---
THROTTLE_USER=600/hour
THROTTLE_ANON=60/hour
THROTTLE_ATTEMPT=120/hour
THROTTLE_HINT=30/hour
THROTTLE_PURCHASE=30/hour
THROTTLE_UPLOAD=40/hour
THROTTLE_FEEDBACK=10/hour
THROTTLE_WEBHOOK=600/hour
LOGIN_MAX_ATTEMPTS=10
LOGIN_BLOCK_SECONDS=900
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_BLOCK_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_BLOCK_SECONDS=3600

# --- Второй фактор сотрудников ---
# С DJANGO_DEBUG=0 включён по умолчанию: бэкофис открывает чужие персональные
# данные, и одного пароля для него мало. Ученик и родитель фактор не проходят.
TWO_FACTOR_ENFORCED=1
TWO_FACTOR_REQUIRED_ROLES=methodist,expert
TWO_FACTOR_ISSUER=Матемация

# --- Процессы ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=4
APP_VERSION=latest
