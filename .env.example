# Django.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: раскомментируйте, чтобы переключиться с SQLite.
# POSTGRES_DB=mathemation
# POSTGRES_USER=mathemation
# POSTGRES_PASSWORD=mathemation
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# REDIS_URL=redis://localhost:6379/0
# =1 выполняет задачи синхронно без Redis (dev-режим).
CELERY_EAGER=1

# AI mentor provider and optional LLM connection.
AI_MENTOR_PROVIDER=
AI_MENTOR_LLM_FORMAT=
AI_MENTOR_LLM_BASE_URL=
AI_MENTOR_LLM_API_KEY=
AI_MENTOR_LLM_MODEL=
AI_MENTOR_LLM_FOLDER_ID=
AI_MENTOR_LLM_TIMEOUT_SECONDS=
AI_MENTOR_LLM_MAX_TOKENS=
AI_MENTOR_LLM_TEMPERATURE=
